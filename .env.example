# Переменные окружения. Скопируйте в .env: cp .env.example .env
# Значения ниже подходят для локальной разработки с `pnpm dev:up`
# (сервисы и dev-пароли — в docker-compose.yml). Настоящие секреты
# не коммитятся: только в .env и в секретах окружения (GitHub Environments).
# Проверка при старте и описание каждой переменной — src/lib/env/schema.ts.

# --- Приложение ---
# Публичный адрес сайта: ссылки в письмах, редиректы, OG.
APP_URL=http://localhost:3000
# Часовой пояс приюта (IANA): начальное значение настройки shelter.timezone
# при `pnpm db:seed` и запасное, пока её нет. Время в БД — в UTC.
SHELTER_TIMEZONE=Europe/Moscow

# --- PostgreSQL 16 (dev: сервис postgres) ---
DATABASE_URL=postgresql://shelter:shelter@localhost:5432/shelter

# --- Вход сотрудников (Better Auth) ---
# Подписывает cookie сессий и шифрует TOTP-секреты, от 32 символов. Секрет,
# поэтому здесь пусто — сгенерируйте свой: openssl rand -base64 32
# Смена секрета завершает все сессии и ломает уже настроенные TOTP.
BETTER_AUTH_SECRET=

# --- Seed (`pnpm db:seed`; приложение их не читает) ---
# Email владельца (роль OWNER): seed назначает его, только пока в базе нет владельца.
SEED_OWNER_EMAIL=owner@shelter.localhost
# Пароль владельца для первого входа в /admin, от 12 символов. Seed задаёт его,
# только если у владельца ещё нет пароля. Придумайте свой.
SEED_OWNER_PASSWORD=
# Только для dev и тестов: TOTP-секрет владельца (от 16 символов) вместо
# настройки приложения-аутентификатора при первом входе. Это строка, а не
# base32-ключ из приложения: в приложение вводится base32 от её байтов UTF-8.
# В production пусто — с NODE_ENV=production seed откажется его ставить.
SEED_OWNER_TOTP_SECRET=
# Только для dev и тестов: опубликовать тексты-заглушки юридических документов
# («черновик, не юридический текст»), чтобы на сайте была оферта и работала
# форма пожертвования. Публикацию нельзя отменить, поэтому seed соглашается
# только с локальным APP_URL и не под NODE_ENV=production. На настоящем сайте
# строку убрать: документы публикует владелец в админке.
SEED_PUBLISH_LEGAL_STUBS=true

# --- S3-совместимое хранилище (dev: MinIO, prod: Yandex Object Storage) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-central1
S3_BUCKET=shelter
S3_ACCESS_KEY_ID=shelter
S3_SECRET_ACCESS_KEY=shelter-dev-secret
# MinIO — true; Yandex Object Storage — false.
S3_FORCE_PATH_STYLE=true

# --- Почта (dev: Mailpit, prod: SMTP провайдера в РФ, см. ADR-0004) ---
SMTP_HOST=localhost
SMTP_PORT=1025
# true — TLS сразу (порт 465); false — без TLS или STARTTLS.
SMTP_SECURE=false
# Логин и пароль задаются вместе; для Mailpit не нужны.
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Приют <no-reply@shelter.localhost>"

# --- Платежи (src/server/payments, docs/payments.md) ---
# Кто принимает деньги: cloudpayments (staging и production) или fake —
# эмулятор для dev и CI, который ничего не списывает. Пусто — fake, но только
# в разработке и тестах: production-сборка (`pnpm start`) требует значение.
# С fake сервер запускается, только если APP_URL — этот компьютер
# (localhost, 127.0.0.1): на публичном адресе нужен cloudpayments.
PAYMENT_PROVIDER=
# Public ID и API Secret терминала из личного кабинета CloudPayments;
# обязательны при PAYMENT_PROVIDER=cloudpayments. API Secret — секрет
# (им же подписаны вебхуки), поэтому здесь пусто.
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
# true — только там, где терминал тестовый (staging): принимать его платежи.
# Пусто — false: тестовый платёж не деньги, сайт его отклонит.
CLOUDPAYMENTS_ACCEPT_TEST_PAYMENTS=

# --- Порты docker compose (по умолчанию; меняйте, если порт занят) ---
# Поменяли порт — поправьте и адрес выше (DATABASE_URL, S3_ENDPOINT, SMTP_PORT).
# POSTGRES_PORT=5432
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025
