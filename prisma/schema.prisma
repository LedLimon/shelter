// Schema conventions (ids, time, money, naming): docs/architecture.md#соглашения-схемы

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Identity -----------------------------------------------------------------

enum UserRole {
  DONOR
  VOLUNTEER
  COORDINATOR
  EDITOR
  ADMIN
  OWNER
}

/// Staff and donors. Sign-in goes through Better Auth (src/server/auth), which
/// also owns Session, Account, Verification, TwoFactor and RateLimit below.
model User {
  id               String    @id @default(cuid(2))
  /// Stored lowercased.
  email            String    @unique
  emailVerified    Boolean   @default(false)
  name             String
  /// Better Auth's avatar field; unused for now.
  image            String?
  phone            String?
  role             UserRole  @default(DONOR)
  /// A verified TOTP authenticator; staff can't reach the admin without it.
  twoFactorEnabled Boolean   @default(false)
  /// Soft delete: donations and audit records keep pointing at the user.
  deletedAt        DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  sessions           Session[]
  accounts           Account[]
  twoFactor          TwoFactor?
  uploadedMedia      Media[]
  ledgerTransactions LedgerTransaction[]
}

// --- Auth (Better Auth) -------------------------------------------------------
// Field names are Better Auth's; it checks them against this schema on start.

model Session {
  id                String   @id @default(cuid(2))
  /// Random; the cookie carries it with an HMAC signature.
  token             String   @unique
  expiresAt         DateTime @db.Timestamptz(3)
  ipAddress         String?
  userAgent         String?
  /// Created by a TOTP or backup-code check (or carried over from such a
  /// session). The admin requires it, whatever sign-in methods appear later.
  twoFactorVerified Boolean  @default(false)
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

/// A way to sign in. Staff: providerId "credential" with a password hash.
model Account {
  id                    String    @id @default(cuid(2))
  /// For "credential" — the user id.
  accountId             String
  providerId            String
  /// Hash in Better Auth's format (scrypt); written only through Better Auth.
  password              String?
  // OAuth fields (VK ID, Yandex ID later); unused for now.
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
}

/// Short-lived values: two-factor challenges and their attempt counters.
model Verification {
  id         String   @id @default(cuid(2))
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

/// TOTP authenticator of a user.
model TwoFactor {
  id                      String    @id @default(cuid(2))
  /// Encrypted with BETTER_AUTH_SECRET.
  secret                  String
  /// Encrypted JSON list of unused backup codes.
  backupCodes             String
  /// false until the user enters the first code from the app.
  verified                Boolean   @default(true)
  /// Wrong codes in a row; at 10 sign-in is locked until lockedUntil.
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime? @db.Timestamptz(3)
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Better Auth doesn't write these; Prisma does.
  createdAt               DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @db.Timestamptz(3)
}

/// Sign-in rate limit buckets, one per client IP and auth path.
model RateLimit {
  id          String   @id @default(cuid(2))
  key         String   @unique
  count       Int
  /// Unix time in milliseconds.
  lastRequest BigInt
  // Better Auth doesn't write these; Prisma does.
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

// --- Settings -----------------------------------------------------------------

/// Shelter-wide settings edited in the admin. Value shapes: src/server/settings.
model Setting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

// --- Media --------------------------------------------------------------------

enum MediaKind {
  PHOTO
  RECEIPT
  INVOICE
  DOCUMENT
}

/// A file in S3. Receipts and invoices are shown publicly only when redacted.
model Media {
  id           String    @id @default(cuid(2))
  storageKey   String    @unique
  mime         String
  kind         MediaKind
  width        Int?
  height       Int?
  /// Tiny blurred placeholder (data URL).
  blur         String?
  /// Personal data on the document is painted over; only then it may be public.
  redacted     Boolean   @default(false)
  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  @@index([uploadedById])
}

// --- Outbox -------------------------------------------------------------------

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED
}

/// Side effects (emails, notifications) written in the same transaction as the
/// business data; the worker runs them after commit. Written only through
/// outbox.enqueue() of src/server/jobs, settled only by its dispatcher.
model Outbox {
  id          String       @id @default(cuid(2))
  /// Event type, e.g. "donation.thanks": a key of outboxEvents.
  type        String
  /// Ids only, no personal data: the handler loads the rest.
  payload     Json
  /// One event per key, e.g. "donation.thanks:{donationId}". Rows are kept, so
  /// the key guards against a repeated side effect for good.
  dedupeKey   String?      @unique
  status      OutboxStatus @default(PENDING)
  /// Attempts started: the dispatcher adds one when it claims the event.
  attempts    Int          @default(0)
  /// Not to be picked up before this time: the retry backoff, and the lease
  /// of the worker running the event. The database's clock, like the
  /// dispatcher's now(): the app's may differ.
  availableAt DateTime     @default(dbgenerated("transaction_timestamp()")) @db.Timestamptz(3)
  /// Why the last failed attempt failed; stays after a later success. No
  /// personal data here either (no raw SMTP replies with addresses).
  lastError   String?
  processedAt DateTime?    @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  @@index([status, availableAt])
}

// --- Email --------------------------------------------------------------------

/// An email the SMTP server has accepted: the mark that keeps an outbox event
/// run again from sending it twice. Written only by sendEmail() of
/// src/server/email. No address and no content: those stay with the domain
/// data the email was built from. Append-only.
model EmailDelivery {
  id        String   @id @default(cuid(2))
  /// What the email answers to — the id of the outbox event that sent it. One
  /// email per key, for good.
  key       String   @unique
  /// A key of the email registry, e.g. "donation.thanks".
  type      String
  /// The Message-ID header it left with, to find it in the provider's log.
  messageId String
  sentAt    DateTime @default(dbgenerated("transaction_timestamp()")) @db.Timestamptz(3)
}

// --- Ledger -------------------------------------------------------------------
// Append-only double-entry book: docs/ledger.md, ADR-0003. Only
// src/server/ledger reads and writes these models (ESLint rule
// shelter/ledger-boundary). Invariants are enforced by triggers in the
// migration `ledger`, not only by the module.

enum LedgerAccountKind {
  GENERAL_FUND
  NEED
  DONATIONS_IN
  EXPENSES_OUT
  REFUNDS_OUT
  FEES_OUT
  IN_KIND_IN
  IN_KIND_USED
}

/// A balance holder. System accounts (one per kind except NEED) are created by
/// the migration with id = code = kind; a need gets its own NEED account.
/// Immutable: no UPDATE or DELETE.
model LedgerAccount {
  id        String            @id @default(cuid(2))
  /// The kind for system accounts, "need:{needId}" for need accounts.
  code      String            @unique
  kind      LedgerAccountKind
  /// Set exactly for NEED accounts. The foreign key to Need comes with the
  /// Need model (NEED-1).
  needId    String?           @unique
  createdAt DateTime          @default(dbgenerated("transaction_timestamp()")) @db.Timestamptz(3)

  entries LedgerEntry[]
}

enum LedgerTransactionKind {
  DONATION
  OVERFLOW
  ALLOCATE_FROM_GENERAL
  EXPENSE
  LEFTOVER_TO_GENERAL
  SHORTFALL_COVER
  REFUND
  FEE
  IN_KIND
  CANCEL_TO_GENERAL
  REVERSAL
}

/// One business event: two or more entries that sum to zero. Immutable; a
/// mistake is undone by a REVERSAL that mirrors the entries.
model LedgerTransaction {
  id             String                @id @default(cuid(2))
  /// Insertion order, for a stable order of transactions with equal postedAt
  /// (a donation and its overflow are posted in one database transaction).
  seq            BigInt                @unique @default(autoincrement())
  kind           LedgerTransactionKind
  /// Deterministic per event: "donation:{id}", "overflow:{donationId}",
  /// "reversal:{transactionId}"… A repeated post with the same key is a no-op.
  idempotencyKey String                @unique
  /// When the event happened (e.g. paid at the provider); may fall in a
  /// closed month, e.g. a late webhook.
  // transaction_timestamp() is now(); a default written as now() reads back
  // as Prisma's @default(now()) and shows up as schema drift.
  occurredAt     DateTime              @default(dbgenerated("transaction_timestamp()")) @db.Timestamptz(3)
  /// When it entered the books: the start time of the database transaction,
  /// set by the default; a trigger rejects any other value, so nothing is
  /// backdated. Must not fall in a month with a published report.
  postedAt       DateTime              @default(dbgenerated("transaction_timestamp()")) @db.Timestamptz(3)
  /// Shown in the public ledger: no personal data.
  publicMemo     String?
  /// Set exactly for REVERSAL; unique, so a transaction is reversed at most once.
  reversesId     String?               @unique
  reverses       LedgerTransaction?    @relation("Reversal", fields: [reversesId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reversedBy     LedgerTransaction?    @relation("Reversal")
  /// The staff member who posted it; null for webhooks and jobs.
  actorId        String?
  actor          User?                 @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// The database transaction that inserted it: only that one may add its
  /// entries. Set by the default, checked by a trigger.
  createdXid     Unsupported("xid8")   @default(dbgenerated("pg_current_xact_id()"))
  // donationId, expenseId and inKindId come with their models, each with a
  // foreign key (onDelete: Restrict) — docs/ledger.md#модель.

  entries LedgerEntry[]

  @@index([actorId])
  @@index([postedAt])
}

/// A signed movement on one account: "−" at the source, "+" at the receiver.
/// Immutable; added only together with its transaction.
model LedgerEntry {
  id            String            @id @default(cuid(2))
  transactionId String
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  accountId     String
  account       LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Signed, never zero.
  amountKop     Int
  /// Copy of the transaction's postedAt (checked by a trigger), for balances
  /// at a moment without a join.
  postedAt      DateTime          @db.Timestamptz(3)

  @@index([transactionId])
  @@index([accountId, postedAt])
}

// --- Reports ------------------------------------------------------------------

enum MonthlyReportStatus {
  DRAFT
  PUBLISHED
}

/// Monthly transparency report. Minimal for now: the ledger needs to know which
/// months are closed. Snapshot, commentary and the rest come with REP-1.
model MonthlyReport {
  id          String              @id @default(cuid(2))
  /// "YYYY-MM" in the shelter's time zone.
  period      String              @unique
  /// The month's bounds as instants, fixed when the report is created, so a
  /// later change of the shelter's time zone doesn't move a closed month.
  /// Half-open: periodStart <= t < periodEnd.
  periodStart DateTime            @db.Timestamptz(3)
  periodEnd   DateTime            @db.Timestamptz(3)
  /// PUBLISHED closes the month for the ledger: allowed once periodEnd has
  /// passed, final (a trigger freezes the report).
  status      MonthlyReportStatus @default(DRAFT)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
}
