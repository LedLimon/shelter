{
  "name": "shelter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "dev:up": "docker compose up -d --wait && docker compose run --rm minio-init",
    "dev:down": "docker compose down",
    "dev:reset": "docker compose down --remove-orphans && docker compose run --rm data-reset && pnpm dev:up",
    "db:migrate": "prisma generate && prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset && prisma generate && prisma db seed",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --tsconfig tsconfig.worker.json worker/index.ts",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write . \"!**/.data/**\"",
    "format:check": "prettier --check . \"!**/.data/**\"",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "e2e": "playwright test",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-email/render": "2.1.0",
    "@tanstack/react-table": "9.2.4",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "libheif-js": "1.23.2",
    "lucide-react": "^1.53.0",
    "next": "16.4.0",
    "nodemailer": "10.0.13",
    "pg-boss": "12.35.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "uqr": "0.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@testcontainers/postgresql": "12.2.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4",
    "testcontainers": "12.2.0",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
